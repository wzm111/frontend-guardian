<!-- 🔴 图片缺少 mode 属性 -->
<image src="/images/banner.png" />

<!-- 🔴 硬编码中文 -->
<view class="container">
  <text class="title">欢迎来到小程序</text>
  <button onTap="onTapItem">点击查看详情</button>
</view>

<!-- 🔴 列表没有使用虚拟滚动 -->
<scroll-view scroll-y>
  <view wx:for="{{list}}" wx:key="index">
    <text>{{item.name}}</text>
  </view>
</scroll-view>
