{
  "name": "frontend-guardian-core",
  "version": "1.0.0",
  "description": "Core analysis engine for frontend-guardian — AST-based scanning and auto-fixing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fg-core": "./bin/fg-core.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "frontend",
    "governance",
    "i18n",
    "lint",
    "ast",
    "codemod"
  ],
  "author": "wzm111",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "jscodeshift": "^17.1.0",
    "yaml": "^2.7.0",
    "globby": "^14.1.0",
    "minimatch": "^10.0.1",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.6",
    "@types/jscodeshift": "^0.12.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
